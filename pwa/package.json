{
  "name": "dosym-pwa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "node scripts/prepare-avatar.mjs && next build",
    "predev": "node scripts/prepare-avatar.mjs",
    "profile:performance": "node scripts/profile-performance.mjs",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts && playwright test"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.160.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.0"
  }
}
